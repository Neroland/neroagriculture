{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "NeroAgriculture - multiloader build (Fabric).",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "accessWidener": "neroagriculture.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": ["za.co.neroland.neroagriculture.fabric.NeroAgricultureFabric"],
    "client": ["za.co.neroland.neroagriculture.fabric.NeroAgricultureFabricClient"],
    "jei_mod_plugin": ["za.co.neroland.neroagriculture.compat.jei.NeroAgricultureJeiPlugin"],
    "emi": ["za.co.neroland.neroagriculture.compat.emi.NeroAgricultureEmiPlugin"]
  },
  "mixins": [
    "neroagriculture-common.mixins.json",
    "neroagriculture.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "nerolandcore": ">=${nerolandcore_version}"
  }
}
